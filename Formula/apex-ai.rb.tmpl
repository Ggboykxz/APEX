# This formula is rendered by scripts/render_homebrew.py during the release.
# Do not edit it by hand: change Formula/apex-ai.rb.tmpl instead.
class ApexAi < Formula
  desc "Universal AI coding agent - every model, one terminal"
  homepage "https://apex-ai.dev"
  url "__SDIST_URL__"
  sha256 "__SDIST_SHA256__"
  license :cannot_represent
  head "https://github.com/Ggboykxz/APEX.git", branch: "dev"

  depends_on "python@3.12"

  def install
    python = Formula["python@3.12"].opt_bin/"python3.12"
    site = libexec/"lib/python3.12/site-packages"

    system python, "-m", "pip", "install",
           "--ignore-installed",
           "--prefix=#{libexec}",
           "--no-warn-script-location",
           "apex-ai==#{version}"

    (bin/"apex").write <<~EOS
      #!/bin/bash
      export PYTHONPATH="#{site}${PYTHONPATH:+:$PYTHONPATH}"
      exec "#{python}" -m apex "$@"
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/apex --version 2>&1", 0)
  end
end
