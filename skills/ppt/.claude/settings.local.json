{
  "permissions": {
    "allow": [
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch",
      "Bash(node scripts/build.js)",
      "Bash(ls /share/hc/utils/superz/test_beam6/ppt_normal_zh_66/download/ppt-workspace/*.html)",
      "Bash(sort -t_ -k4 -n)",
      "Bash(ls /share/hc/utils/superz/test_beam6/ppt_normal_zh_79/download/ppt-workspace/*.html)",
      "Bash(ls /share/hc/utils/superz/test_beam6/ppt_normal_zh_78/download/ppt-workspace/*.html)",
      "Bash(xargs -I{} head -3 {})",
      "Bash(npm root)",
      "Read(/share/hc/utils/superz/p-p-p-x/ppt0403/node_modules/**)",
      "Read(./**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(wget * -O- | sh)",
      "Read(//root/**)",
      "Read(/etc/passwd)",
      "Read(/etc/shadow)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(*)",
        "command": "node scripts/security-preflight.js"
      },
      {
        "matcher": "Write(*)",
        "command": "node scripts/security-preflight.js"
      },
      {
        "matcher": "Edit(*)",
        "command": "node scripts/security-preflight.js"
      }
    ]
  }
}
