{
  "name": "apex-tui",
  "version": "2.0.0",
  "description": "APEX Terminal User Interface - Ink + React (Node.js compatible)",
  "main": "src/App.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/App.tsx",
    "start": "tsx src/App.tsx",
    "dev:bun": "bun --bun run src/App.tsx",
    "start:bun": "bun --bun run src/App.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "bun test"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1",
    "react-reconciler": "^0.34.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
