{
  "name": "apex-desktop",
  "version": "0.1.0",
  "description": "APEX desktop application (Electron) — thin client for the APEX backend",
  "main": "src/main.ts",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-builder"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "vite": "^7.3.7",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "dev.apex-ai.desktop",
    "productName": "APEX",
    "files": ["out/**", "src/**"],
    "linux": { "target": ["AppImage", "deb", "rpm"] },
    "mac": { "target": ["dmg"] },
    "win": { "target": ["nsis"] }
  }
}
