{
  "name": "apex-vscode",
  "displayName": "APEX",
  "description": "Thin client for the APEX AI coding agent backend (apex serve)",
  "version": "0.1.0",
  "publisher": "apex",
  "private": true,
  "license": "Proprietary",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:apex.chat",
    "onCommand:apex.explainSelection",
    "onCommand:apex.fixSelection",
    "onCommand:apex.reviewDiff",
    "onCommand:apex.newSession",
    "onCommand:apex.setApiKey",
    "onCommand:apex.restartServer"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apex.chat",
        "title": "APEX: Open Chat"
      },
      {
        "command": "apex.newSession",
        "title": "APEX: New Session"
      },
      {
        "command": "apex.explainSelection",
        "title": "APEX: Explain Selection"
      },
      {
        "command": "apex.fixSelection",
        "title": "APEX: Fix Selection"
      },
      {
        "command": "apex.reviewDiff",
        "title": "APEX: Review Working Tree Diff"
      },
      {
        "command": "apex.setApiKey",
        "title": "APEX: Set Backend API Key"
      },
      {
        "command": "apex.restartServer",
        "title": "APEX: Restart Backend Server"
      }
    ],
    "configuration": {
      "title": "APEX",
      "properties": {
        "apex.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Base URL of the APEX backend (apex serve)."
        },
        "apex.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start `apex serve` automatically when no backend responds."
        },
        "apex.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model for new sessions (empty = backend default)."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "apex.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "apex.fixSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "apex.chat",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/test/",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
